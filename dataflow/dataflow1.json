{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_ADLSGEN2_customer",
						"type": "DatasetReference"
					},
					"name": "customerdata"
				},
				{
					"dataset": {
						"referenceName": "DS_ADLSGEN2_orders",
						"type": "DatasetReference"
					},
					"name": "ordersdata"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_India_silver",
						"type": "DatasetReference"
					},
					"name": "indiasink"
				},
				{
					"dataset": {
						"referenceName": "DS_usa_silver",
						"type": "DatasetReference"
					},
					"name": "usasink"
				},
				{
					"dataset": {
						"referenceName": "DS_uk_Silver",
						"type": "DatasetReference"
					},
					"name": "uksink"
				},
				{
					"dataset": {
						"referenceName": "DS_others_silver",
						"type": "DatasetReference"
					},
					"name": "othersink"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          customer_id as integer,",
				"          first_name as string,",
				"          last_name as string,",
				"          email as string,",
				"          country as string,",
				"          signup_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> customerdata",
				"source(output(",
				"          order_id as integer,",
				"          order_date as string,",
				"          customer_id as integer,",
				"          product_name as string,",
				"          quantity as integer,",
				"          price as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> ordersdata",
				"customerdata, ordersdata join(customerdata@customer_id == ordersdata@customer_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     partitionBy('hash', 1),",
				"     broadcast: 'auto')~> join1",
				"join1 filter(!isNull(customerdata@customer_id),",
				"     partitionBy('hash', 1)) ~> filter1",
				"filter1 split(equals(country, 'India'),",
				"     equals(country, 'USA'),",
				"     equals(country, 'UK'),",
				"     !(country=='India' || country=='USA' || country=='UK'),",
				"     disjoint: false,",
				"     partitionBy('hash', 1)) ~> split1@(india, usa, uk, others)",
				"split1@india sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> indiasink",
				"split1@usa sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> usasink",
				"split1@uk sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> uksink",
				"split1@others sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> othersink"
			]
		}
	}
}